# Publish only reviewed source, resources, build files and public documentation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/THIRD_PARTY_NOTICES.md
!/app/
!/docs/
!/licenses/
/app/*
!/app/AndroidManifest.xml
!/app/build.ps1
!/app/src/
!/app/stub-src/
!/app/res/
!/app/META-INF/
!/app/libs/
/app/libs/*
!/app/libs/service-classes.jar
/docs/*
!/docs/COMPATIBILITY.md
!/docs/releases/
*.keystore
*.jks
*.p12
*.pem
*.key
*.apk
*.idsig
*.log
.env*
__pycache__/
