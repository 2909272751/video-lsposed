<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.qqliveclean"
    android:versionCode="100"
    android:versionName="1.0.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <queries>
        <package android:name="com.tencent.qqlive" />
        <package android:name="com.youku.phone" />
        <package android:name="com.qiyi.video" />
        <!--
          The four rule sets merged in from standalone modules read their settings through this
          module's ConfigProvider. Without them here, package visibility hides the provider from
          those apps and every one of their switches silently falls back to its built-in default -
          which is exactly what happened on the first attempt.
        -->
        <package android:name="com.tencent.qqmusic" />
        <package android:name="com.sdu.didi.psnger" />
        <package android:name="com.taobao.taobao" />
        <package android:name="com.taobao.idlefish" />
        <package android:name="com.sina.weibo" />
    </queries>
    <application
        android:name=".App"
        android:label="广告净化"
        android:description="@string/description"
        android:icon="@drawable/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="io.github.libxposed.service.XposedProvider"
            android:authorities="io.github.qqliveclean.XposedService"
            android:exported="true" />
        <!-- Settings channel: the hooked process reads the whitelisted keys from here.
             Deliberately not LSPosed's RemotePreferences, whose settings-side binder is
             never delivered on this device (see ConfigProvider docs). -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="io.github.qqliveclean.config"
            android:grantUriPermissions="true"
            android:exported="true" />
        <receiver android:name=".ReportReceiver" android:exported="true" />
    </application>
</manifest>
